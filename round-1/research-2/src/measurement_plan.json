{
  "knowledge_redundancy": {
    "primary_measure": "jaccard_similarity",
    "formula": "average_pairwise_jaccard",
    "scope": "top_10_contributors",
    "weighting": "none",
    "sensitivity_analyses": [
      {
        "measure": "weighted_jaccard",
        "weight_by": "commit_count"
      },
      {
        "measure": "overlap_coefficient",
        "weight_by": "none"
      },
      {
        "measure": "degree_of_authorship",
        "algorithm": "avelino_2016",
        "parameters": {
          "fa_weight": 3.293,
          "dl_weight": 0.164,
          "ac_weight": -0.321,
          "threshold_normalized_doa": 0.75,
          "threshold_absolute_doa": 3.293
        }
      },
      {
        "measure": "hhi_index",
        "interpretation": "lower_hhi_means_lower_redundancy"
      }
    ]
  },
  "bus_factor": {
    "algorithm": "avelino_2016",
    "source": "https://github.com/aserg-ufmg/Truck-Factor",
    "parameters": {
      "doa_formula": "3.293 + 1.098*FA + 0.164*DL - 0.321*ln(1+AC)",
      "coverage_threshold": 0.50,
      "author_threshold_normalized_doa": 0.75,
      "author_threshold_absolute_doa": 3.293,
      "alias_detection": "levenshtein_distance_threshold_1"
    },
    "validation": {
      "survey_agreement": "84%",
      "survey_sample": "67 GitHub projects",
      "comparative_study": "Best precision/recall (SBCARS 2016)"
    }
  },
  "survival": {
    "definition": "12_month_inactivity",
    "threshold": "<1_commit_per_month",
    "window_months": 12,
    "founder_departure_identification": {
      "founder_definition": "most_commits_first_6_months",
      "departure_threshold_months": 12,
      "edge_case_threshold": "less_than_6_commits_in_12_months"
    },
    "censoring": "right_censoring_at_data_collection_end",
    "competing_risks": "consider_fine_gray_model"
  },
  "control_variables": {
    "project_age": {
      "definition": "days_from_first_commit_to_founder_departure",
      "transformation": "none"
    },
    "project_size": {
      "metrics": ["total_commits", "total_files", "lines_of_code"],
      "transformation": "log1p"
    },
    "popularity": {
      "metrics": ["stars", "forks", "unique_contributors"],
      "transformation": "log1p",
      "source": "Ali et al. (2020) found HR=0.997 per contributor, p<0.001"
    },
    "programming_language": {
      "encoding": "one_hot_top_10_languages"
    },
    "release_history": {
      "definition": "binary_has_releases",
      "source": "Ali et al. (2020) found HR=0.15 for projects with releases, p<0.001"
    }
  },
  "statistical_analysis": {
    "model": "cox_proportional_hazards",
    "library": "python_lifelines",
    "quadratic_term": {
      "formula": "h(t) = h0(t) * exp(b1*X + b2*X^2 + b3*Z)",
      "hypothesis": "b1 > 0 AND b2 < 0 for inverted-U",
      "interpretation": "turning_point = -b1/(2*b2)",
      "diagnostic": "likelihood_ratio_test_linear_vs_quadratic"
    },
    "assumptions": {
      "proportional_hazards": "Schoenfeld residuals test (p > 0.05)",
      "linearity": "Martingale residuals plot",
      "collinearity": "VIF < 5",
      "influential_observations": "dfbeta residuals"
    },
    "time_varying_covariates": {
      "available": true,
      "method": "CoxTimeVaryingFitter in lifelines",
      "note": "Complicates interpretation of quadratic terms"
    },
    "competing_risks": {
      "available": true,
      "method": "Fine-Gray model or cause-specific hazards"
    }
  },
  "data_collection": {
    "api": "github_graphql",
    "rate_limits": {
      "authenticated": "5000 points/hour",
      "graphql_points": "query=1, mutation=5",
      "secondary_limits": "max 90s CPU/minute, 100 concurrent, 900 points/minute"
    },
    "optimization": {
      "batch_queries": true,
      "cursor_pagination": true,
      "caching": "SQLite with ETag/Last-Modified",
      "estimated_calls_per_repo": "3-5 (vs. 15-25 REST)"
    },
    "time_estimate": "2 hours for 2000 repos"
  },
  "power_analysis": {
    "rule_of_thumb": "10 events per variable",
    "variables": 10,
    "minimum_events": 100,
    "expected_events_2000_projects": 180,
    "conclusion": "Sufficient power"
  },
  "validation": {
    "manual_validation_sample": "30-50 founder departures",
    "sensitivity_analysis": [
      "abandonment_threshold (6, 12, 18 months)",
      "alternative_redundancy_measures",
      "different_control_variable_transformations"
    ]
  }
}
